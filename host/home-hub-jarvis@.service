[Unit]
Description=Keep Jarvis running in tmux from boot, as %i
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=%i
WorkingDirectory=~
Environment=HOME_HUB_DIR=/home/%i/docker
ExecStart=/usr/local/bin/home-hub-jarvis start
ExecStop=/usr/local/bin/home-hub-jarvis stop
NoNewPrivileges=yes
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
