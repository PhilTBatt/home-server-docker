{
  "disableClaudeAiConnectors": true,
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "mcp__hub__scan_library",
      "mcp__hub__stop_download",
      "mcp__hub__start_download",
      "mcp__hub__add_watcher",
      "mcp__hub__cancel_watcher",
      "mcp__hub__run_chore",
      "mcp__hub__set_reminder",
      "mcp__hub__cancel_reminder",
      "mcp__hub__snooze_reminder",
      "mcp__hub__spotify_play",
      "mcp__hub__spotify_pause",
      "mcp__hub__spotify_next",
      "mcp__hub__spotify_previous",
      "mcp__hub__spotify_seek",
      "mcp__hub__spotify_volume",
      "mcp__hub__spotify_shuffle",
      "mcp__hub__spotify_repeat",
      "mcp__hub__spotify_queue_add",
      "mcp__hub__spotify_transfer",
      "mcp__hub__spotify_playlist_add",
      "mcp__hub__spotify_save"
    ],
    "allow": [
      "mcp__hub__get_status",
      "mcp__hub__get_alerts",
      "mcp__hub__get_features",
      "mcp__hub__get_downloads",
      "mcp__hub__get_library",
      "mcp__hub__get_wifi_reconnects",
      "mcp__hub__get_backup",
      "mcp__hub__get_expiries",
      "mcp__hub__get_doctor",
      "mcp__hub__get_watchers",
      "mcp__hub__get_mode",
      "mcp__hub__get_reminders",
      "mcp__hub__get_chore",
      "mcp__hub__get_sessions",
      "mcp__hub__get_catch_up",
      "mcp__hub__get_deal_status",
      "mcp__hub__get_deal_searches",
      "mcp__hub__get_deal_matches",
      "mcp__hub__get_deal_listing",
      "mcp__hub__get_deal_search_cuts",
      "mcp__hub__lookup_deal_categories",
      "mcp__hub__lookup_deal_details",
      "mcp__hub__get_deal_hidden",
      "mcp__hub__explain_deal_listing",
      "WebSearch",
      "WebFetch(domain:www.dell.com)",
      "WebFetch(domain:dl.dell.com)",
      "WebFetch(domain:www.hp.com)",
      "WebFetch(domain:support.hp.com)",
      "WebFetch(domain:h20195.www2.hp.com)",
      "WebFetch(domain:psref.lenovo.com)",
      "WebFetch(domain:pcsupport.lenovo.com)",
      "WebFetch(domain:www.intel.com)",
      "WebFetch(domain:www.amd.com)",
      "WebFetch(domain:www.kingston.com)",
      "WebFetch(domain:www.crucial.com)",
      "WebFetch(domain:semiconductor.samsung.com)",
      "WebFetch(domain:www.micron.com)",
      "WebFetch(domain:www.corsair.com)",
      "WebFetch(domain:www.westerndigital.com)",
      "WebFetch(domain:www.seagate.com)",
      "WebFetch(domain:www.mrmemory.co.uk)",
      "WebFetch(domain:jellyfin.org)",
      "WebFetch(domain:linux-hardware.org)",
      "WebFetch(domain:www.servethehome.com)",
      "mcp__hub__get_spotify_playing",
      "mcp__hub__get_spotify_devices",
      "mcp__hub__get_spotify_queue",
      "mcp__hub__get_spotify_search",
      "mcp__hub__get_spotify_playlists"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(./adguard/**)",
      "Read(./beszel/**)",
      "Read(./caddy/config/**)",
      "Read(./caddy/data/**)",
      "Read(./deals/state.json)",
      "Read(./deals/state.json.bad)",
      "Read(./homepage/config/**)",
      "Read(./jellyfin/**)",
      "Read(./kuma/**)",
      "Read(./media-stack/**)",
      "Read(~/hub-memory/**)",
      "Edit(./ears/switch/**)",
    "Edit(./host/hub-session.sh)",
      "Read(./ears/voice/**)",
      "Bash(bash host/ears.sh unmute *)",
      "Bash(bash host/ears.sh talk *)",
      "WebFetch(domain:ebay.co.uk)",
      "WebFetch(domain:*.ebay.co.uk)",
      "WebFetch(domain:ebay.com)",
      "WebFetch(domain:www.ebay.com)",
      "WebFetch(domain:m.ebay.com)",
      "Read(./projector/**)",
      "Read(./spotify/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker working",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker working",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker waiting",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/host/hub-session.sh\" docker stopped",
            "timeout": 5
          }
        ]
      }
    ]
  }
}